# Bazzite image with workstation customizations and the shared hypervisor base.
FROM scratch AS ctx
COPY build_files/common /
COPY build_files/bazzite /

# ---------------------------------------------------------------------------
# Build stage: compile Astal runtime libraries + AGS binary from source
# No COPR provides functional Astal or AGS packages for Fedora 44.
# Astal = Vala GObject libraries, AGS = Go binary + JS data.
# Installs to /usr/ (not /usr/local/) because in bootc images /usr/local
# is a symlink to /var/usrlocal which is a runtime-only mount.
# ---------------------------------------------------------------------------
FROM ghcr.io/ublue-os/bazzite:stable AS ags-builder

RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    set -e; \
    # Bazzite's Terra WirePlumber is versionlocked and conflicts with Fedora's
    # wireplumber-devel; lift the lock and allow the matching Fedora packages
    # to replace it for this source-build stage.
    dnf5 versionlock delete wireplumber-libs wireplumber 2>/dev/null || true; \
    dnf5 -y install --allowerasing \
        meson ninja-build git-core \
        vala valadoc \
        gobject-introspection-devel \
        glib2-devel gtk4-devel gtk4-layer-shell-devel \
        golang npm gjs \
        wayland-protocols-devel \
        wireplumber-devel \
        NetworkManager-libnm-devel \
        libsoup3-devel \
        json-glib-devel \
        libgudev-devel \
        python3 && \
    mkdir -p /out && \
    mkdir -p /usr/share/vala/vapi /usr/share/gir-1.0 && \
    export PKG_CONFIG_PATH="/out/usr/lib64/pkgconfig:/out/usr/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" \
        GI_TYPELIB_PATH="/out/usr/lib64/girepository-1.0:/out/usr/lib/girepository-1.0" \
        LD_LIBRARY_PATH="/out/usr/lib64:/out/usr/lib" \
        LIBRARY_PATH="/out/usr/lib64:/out/usr/lib" \
        CPATH="/out/usr/include${CPATH:+:$CPATH}" && \
    expose_staged_metadata() { \
        for file in /out/usr/share/vala/vapi/*; do [ -e "$file" ] && ln -sfn "$file" /usr/share/vala/vapi/; done; \
        for file in /out/usr/share/gir-1.0/*; do [ -e "$file" ] && ln -sfn "$file" /usr/share/gir-1.0/; done; \
    } && \
    # Build Astal libraries (io -> gtk4 -> gjs)
    git clone --depth 1 https://github.com/aylur/astal.git /tmp/astal && \
    meson setup --prefix /usr /tmp/astal/lib/astal/io/build /tmp/astal/lib/astal/io && \
    DESTDIR=/out meson install -C /tmp/astal/lib/astal/io/build && expose_staged_metadata && \
    meson setup --prefix /usr /tmp/astal/lib/astal/gtk4/build /tmp/astal/lib/astal/gtk4 && \
    DESTDIR=/out meson install -C /tmp/astal/lib/astal/gtk4/build && expose_staged_metadata && \
    # Build Astal service libraries
    for lib in wireplumber network battery bluetooth apps powerprofiles; do \
        meson setup --prefix /usr /tmp/astal/lib/$lib/build /tmp/astal/lib/$lib || exit 1; \
        DESTDIR=/out meson install -C /tmp/astal/lib/$lib/build || exit 1; \
        expose_staged_metadata || exit 1; \
    done && \
    # MPRIS, notifd, and brightness CLIs require quarrel-0.1, which is not built.
    for lib in mpris notifd brightness; do \
        meson setup --prefix /usr /tmp/astal/lib/$lib/build /tmp/astal/lib/$lib -Dcli=false || exit 1; \
        DESTDIR=/out meson install -C /tmp/astal/lib/$lib/build || exit 1; \
        expose_staged_metadata || exit 1; \
    done && \
    meson setup --prefix /usr /tmp/astal/lang/gjs/build /tmp/astal/lang/gjs && \
    DESTDIR=/out meson install -C /tmp/astal/lang/gjs/build && expose_staged_metadata && \
    # Build AGS
    git clone --depth 1 https://github.com/aylur/ags.git /tmp/ags && \
    cd /tmp/ags && \
    HOME=/tmp GOCACHE=/tmp/go-cache GOPATH=/tmp/go npm install && \
    meson setup build --prefix /usr && \
    DESTDIR=/out GOCACHE=/tmp/go-cache GOPATH=/tmp/go meson install -C build

# ---------------------------------------------------------------------------
# Final stage
# ---------------------------------------------------------------------------
FROM ghcr.io/ublue-os/bazzite:stable

# Copy custom systemd user services (e.g. polkit agent, idle management)
COPY services/bazzite /usr/lib/systemd/user/

# Install runtime dependencies without copying the builder's replacement
# WirePlumber packages or other build dependencies into the final image.
RUN dnf5 install -y gjs gtk4-layer-shell libsoup3 && dnf5 clean all

# Copy only the runtime payload staged with the /usr prefix.
COPY --from=ags-builder /out/usr/bin/ags /usr/bin/ags
COPY --from=ags-builder /out/usr/lib64/libastal-*.so* /usr/lib64/
COPY --from=ags-builder /out/usr/lib64/girepository-1.0/Astal*.typelib /usr/lib64/girepository-1.0/
COPY --from=ags-builder /out/usr/share/astal/gjs/ /usr/share/astal/gjs/
COPY --from=ags-builder /out/usr/share/ags/ /usr/share/ags/
COPY --from=ags-builder /out/usr/share/glib-2.0/schemas/io.astal.notifd.gschema.xml /usr/share/glib-2.0/schemas/
RUN test -e /usr/lib64/libgtk4-layer-shell.so.0 && \
    ln -sfn libgtk4-layer-shell.so.0 /usr/lib64/libgtk4-layer-shell.so && \
    for library in /usr/lib64/libastal-*.so.[0-9]*.[0-9]*.[0-9]*; do \
        test -f "$library" || continue; \
        soname="${library%.*.*}"; \
        unversioned="${library%%.so.*}.so"; \
        ln -sfn "${library##*/}" "$soname"; \
        ln -sfn "${soname##*/}" "$unversioned"; \
    done && \
    glib-compile-schemas /usr/share/glib-2.0/schemas && ldconfig

## Other possible base images include:
# FROM ghcr.io/ublue-os/bazzite:latest
# FROM ghcr.io/ublue-os/bluefin-nvidia:stable
# 
# ... and so on, here are more base images
# Universal Blue Images: https://github.com/orgs/ublue-os/packages
# Fedora base image: quay.io/fedora/fedora-bootc:41
# CentOS base images: quay.io/centos-bootc/centos-bootc:stream10

### [IM]MUTABLE /opt
## Some bootable images, like Fedora, have /opt symlinked to /var/opt, in order to
## make it mutable/writable for users. However, some packages write files to this directory,
## thus its contents might be wiped out when bootc deploys an image, making it troublesome for
## some packages. Eg, google-chrome, docker-desktop.
##
## Uncomment the following line if one desires to make /opt immutable and be able to be used
## by the package manager.

RUN rm /opt && mkdir /opt

### MODIFICATIONS
## make modifications desired in your image and install packages by modifying the build.sh script
## Copying the scripts makes their content part of Buildah's cache key. A bind
## mount from ctx reused stale RUN output when only build_files changed.

COPY --from=ctx / /ctx/

RUN --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/install-hypervisor.sh && \
    /ctx/build.sh && \
    /ctx/verify-hypervisor.sh && \
    /ctx/verify-container.sh bazzite && \
    install -Dm755 /ctx/verify-container.sh /usr/bin/verify-container.sh && \
    rm -rf /ctx
    
### LINTING
## Verify final image and contents are correct.
RUN bootc container lint
